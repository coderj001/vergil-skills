prefix_rule(
    pattern = ["npx", ["@fission-ai/openspec@latest"]],
    decision = "allow",
    justification = "Common npx openspec operations."
)


prefix_rule(pattern=["git", ["status", "log"]], decision="allow")

prefix_rule(
    pattern = ["http"],
    decision = "allow",
    justification = "Nushell http for curl operation for api"
)
